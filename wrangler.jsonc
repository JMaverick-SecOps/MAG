{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mavverick-scout",
  "main": "src/worker-entry.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./assets"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "workflows": [
    {
      "binding": "MIGRATION_WORKFLOW",
      "name": "mag-migration-orchestrator",
      "class_name": "MigrationWorkflow"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mavverick-scout-marketplace",
      "database_id": "7a31e839-c552-4584-9f8e-d8b453d929f6",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "SCOUT_ENVIRONMENT": "production",
    "SCOUT_MODE": "propose_only",
    "MAG_SUBSCRIPTION_PLANS": "psa-workspace,managed-visibility",
    "MAG_RMM_CONTROL_ENABLED": "false",
    "MAG_AGENT_CONNECTIONS_ENABLED": "true",
    "MAG_HOSTED_WORK_WATCH_ENABLED": "true",
    "SATURNSHIFT_PUBLIC_KEY": "pk_live_5899b51d9021c4fea2e0413901728c75",
    "SATURNSHIFT_WEBHOOK_ENDPOINT_STATUS": "pending_registration",
    "SATURNSHIFT_FIAT_WEBHOOK_STATUS": "unconfirmed"
  }
}
